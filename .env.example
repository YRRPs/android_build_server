# Copy to .env and replace this placeholder with an authorized public SSH key.
SSH_AUTHORIZED_KEYS="ssh-ed25519 AAAA_REPLACE_WITH_PUBLIC_KEY workstation"

# Bind to a trusted LAN address for remote access. Loopback is the safe default.
SSH_BIND_ADDRESS=127.0.0.1
SSH_PORT=4242

USER_UID=1000
USER_GID=1000
ANDROID_WORKSPACE_PATH=./workspace
CCACHE_PATH=./ccache
CCACHE_MAXSIZE=100G

COMPOSE_PROJECT_NAME=android-build-server
CONTAINER_NAME=android-builder
CONTAINER_HOSTNAME=android-builder
