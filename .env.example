# Copy to .env and replace this placeholder with an authorized public SSH key.
SSH_AUTHORIZED_KEYS="ssh-ed25519 AAAA_REPLACE_WITH_PUBLIC_KEY workstation"

# Bind only to VPN/LAN address used by trusted operators.
SSH_BIND_ADDRESS=127.0.0.1
SSH_PORT=4242

USER_UID=1000
USER_GID=1000
ANDROID_WORKSPACE_PATH=./workspace
CCACHE_PATH=./ccache
CCACHE_MAXSIZE=100G
YRRP_PROJECT_PATH=/absolute/host/path/to/project
SIGNING_KEYS_PATH=/absolute/host/path/to/signing

BUILDER_IMAGE=ghcr.io/yrrps/android-build-server:main
OTA_BASE_IMAGE_REF=ghcr.io/yrrps/ota-server:main
OTA_PUBLIC_BASE_URL=https://ota.example.invalid
OTA_NETWORK=proxy-net

COMPOSE_PROJECT_NAME=android-build-server
CONTAINER_NAME=android-builder
CONTAINER_HOSTNAME=android-builder
